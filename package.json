{
  "name": "@adonisjs/lock",
  "description": "Atomic locks (mutex) for AdonisJS applications",
  "version": "2.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./lock_provider": "./build/providers/lock_provider.js",
    "./services/main": "./build/services/main.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles --up 1 \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "tsdown && tsc --emitDeclarationOnly --declaration && npm run copy:templates",
    "release": "npx release-it",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/node": "^25.3.0",
    "better-sqlite3": "^12.6.2",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "luxon": "^3.7.2",
    "mysql": "^2.18.1",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "timekeeper": "^2.3.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@verrou/core": "^0.5.2"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.19 || ^8.0.0",
    "@adonisjs/core": "^7.0.0-next.13 || ^7.0.0",
    "@adonisjs/lucid": "^22.0.0-next.1 || ^22.0.0",
    "@adonisjs/redis": "^10.0.0-next.1 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/redis": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "author": "Julien Ripouteau <julien@ripouteau.com>,adonisjs",
  "license": "MIT",
  "homepage": "https://github.com/adonisjs/lock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/lock.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/lock/issues"
  },
  "keywords": [
    "locks",
    "mutexes",
    "atomic lock",
    "adonisjs"
  ],
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/package"
  },
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "tests_helpers/**"
    ]
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./src/types.ts",
      "./providers/lock_provider.ts",
      "./services/main.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  }
}
